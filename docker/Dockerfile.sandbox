FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates bash ripgrep xxd \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest==8.4.2 bandit==1.8.6

RUN groupadd --gid 10001 aegis \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/sh aegis \
    && mkdir -p /workspace \
    && chown aegis:aegis /workspace

USER 10001:10001
WORKDIR /workspace
